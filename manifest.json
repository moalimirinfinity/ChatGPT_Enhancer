{
  "manifest_version": 3,
  "name": "ChatGPT KaTeX Direction Fix",
  "version": "1.1.0",
  "description": "Keep math and code readable in RTL chats with configurable direction fixes for ChatGPT responses.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KaTeX Direction Fix"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "css": ["styles.css"],
      "js": ["contentScript.js"],
      "run_at": "document_end"
    }
  ]
}
