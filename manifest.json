{
  "manifest_version": 3,
  "name": "GPT Enhancer",
  "version": "1.1.0",
  "description": "Enhance ChatGPT with themes, fonts, KaTeX copy, prompt library, and chat export — lightweight and private.",
  "permissions": ["storage", "tabs", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GPT Enhancer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "css": ["styles.css"],
      "js": [
        "libs/html-docx.min.js",
        "libs/html-to-image.min.js",
        "contentScript.js",
        "exporter.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["libs/*.js", "fonts/*.woff2"],
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"]
    }
  ]
}
