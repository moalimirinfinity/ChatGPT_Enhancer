{
  "manifest_version": 3,
  "name": "GBT Enhancer",
  "version": "1.1.0",
  "description": "Enhance ChatGPT math, code, and themes with smarter RTL-friendly controls.",
  "permissions": ["storage", "tabs", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GBT Enhancer"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "css": ["styles.css"],
      "js": [
        "libs/html2pdf.bundle.min.js",
        "libs/html-docx.min.js",
        "libs/html-to-image.min.js",
        "contentScript.js",
        "exporter.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["libs/*.js"],
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"]
    }
  ]
}
